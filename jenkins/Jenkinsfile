pipeline {
  agent { label 'isolated-security-agent' }

  options {
    disableConcurrentBuilds()
    timestamps()
  }

  parameters {
    string(name: 'RELEASE_REPOSITORY', description: 'GitHub OWNER/REPO that produced the candidate')
    string(name: 'RELEASE_RUN_ID', description: 'GitHub Actions run ID containing candidate evidence')
    string(name: 'RELEASE_COMMIT', description: '40-character source commit SHA')
  }

  stages {
    stage('Retrieve') {
      steps {
        withCredentials([string(credentialsId: 'github-read-token', variable: 'GH_TOKEN')]) {
          sh './jenkins/scripts/retrieve-manifest.sh "$RELEASE_REPOSITORY" "$RELEASE_RUN_ID" "$RELEASE_COMMIT"'
        }
      }
    }
    stage('Verify manifest shape') {
      steps {
        sh './scripts/validate-release-manifest.sh reports/release-manifest.json'
        sh '''
          test "$(jq -r '.source.repository' reports/release-manifest.json)" = "$RELEASE_REPOSITORY"
          test "$(jq -r '.source.commit' reports/release-manifest.json)" = "$RELEASE_COMMIT"
          test "$(jq -r '.builder.run_id' reports/release-manifest.json)" = "$RELEASE_RUN_ID"
          expected_image="ghcr.io/$(printf '%s' "$RELEASE_REPOSITORY" | tr '[:upper:]' '[:lower:]')"
          test "$(jq -r '.artifact.repository' reports/release-manifest.json)" = "$expected_image"
        '''
      }
    }
    stage('Verify signature and identity') {
      steps {
        withCredentials([
          string(credentialsId: 'github-read-token', variable: 'GH_TOKEN'),
          usernamePassword(credentialsId: 'ghcr-readonly', usernameVariable: 'GHCR_USERNAME', passwordVariable: 'GHCR_TOKEN')
        ]) {
          sh '''
            export DOCKER_CONFIG="$(mktemp -d)"
            trap 'docker logout ghcr.io >/dev/null 2>&1 || true; rm -rf "$DOCKER_CONFIG"' EXIT
            printf '%s' "$GHCR_TOKEN" | docker login ghcr.io --username "$GHCR_USERNAME" --password-stdin
            ./jenkins/scripts/verify-image.sh
            ./jenkins/scripts/verify-attestations.sh
          '''
        }
      }
    }
    stage('Deploy exact digest to staging') {
      steps { sh './jenkins/scripts/deploy-staging.sh' }
    }
    stage('Smoke test') {
      steps { sh './jenkins/scripts/smoke-test-staging.sh' }
    }
    stage('DAST baseline') {
      steps { sh './jenkins/scripts/run-dast.sh' }
    }
    stage('Evaluate release policy') {
      steps {
        sh './jenkins/scripts/build-policy-input.sh'
        withEnv(['OPA_INPUT=reports/policy-input.json']) {
          sh './jenkins/scripts/evaluate-policy.sh'
        }
      }
    }
    stage('Approval') {
      steps { input message: 'Promote the verified digest?', ok: 'Promote' }
    }
    stage('Promote exact digest') {
      steps { sh './jenkins/scripts/deploy-production.sh' }
    }
  }

  post {
    always { archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true }
  }
}
